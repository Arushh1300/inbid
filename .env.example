# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only Secret Key (NEVER expose to client / browser code)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Admin passcode for protected dashboard
ADMIN_PASSCODE=your-admin-passcode-here

# DODO Payment Credentials (Server-only)
DODO_PAYMENTS_API_KEY=your-dodo-api-key-here
DODO_PAYMENTS_PRODUCT_ID=your-dodo-product-id-here
DODO_PAYMENTS_ENVIRONMENT=live_mode
DODO_PAYMENTS_WEBHOOK_SECRET=your-dodo-webhook-secret-here

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
